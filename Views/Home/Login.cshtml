@{
    ViewData["Title"] = "Login";
}

<section class="page-section" id="login" style="padding-top: calc(6rem + 74px);">
    <div class="container">
        <!-- Login Section Heading-->
        <h2 class="page-section-heading text-center text-uppercase text-secondary mb-0">Login</h2>
        <!-- Icon Divider-->
        <div class="divider-custom">
            <div class="divider-custom-line"></div>
            <div class="divider-custom-icon"><i class="fas fa-star"></i></div>
            <div class="divider-custom-line"></div>
        </div>
        <!-- Login Section Form-->
        <div class="row justify-content-center">
            <div class="col-lg-8 col-xl-7">
                @if (ViewBag.Message != null)
                {
                    <div class="alert alert-success text-center mb-3">
                        @ViewBag.Message
                    </div>
                }
                @if (ViewData["Message"] != null)
                {
                    <div class="alert alert-success text-center mb-3">
                        @ViewData["Message"]
                    </div>
                }
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3 text-center"></div>

                <form id="loginForm" method="post" action="@Url.Action("Login", "Home")">
                    <!-- Email address input-->
                    <div class="form-floating mb-3">
                        <input class="form-control" name="email" id="email" type="email" placeholder="name@example.com" required />
                        <label for="email">Email address</label>
                    </div>
                    <!-- Password input-->
                    <div class="form-floating mb-3">
                        <input class="form-control" name="password" id="password" type="password" placeholder="Password" required />
                        <label for="password">Password</label>
                    </div>
                    <!-- Redirect to Register-->
                    <div class="mb-4 text-center">
                        <span class="text-muted">Don't have an account?</span>
                        <a href="@Url.Action("Register", "Home")" class="text-primary fw-bold" style="text-decoration: none;">Register</a>
                    </div>
                    <!-- Submit Button-->
                    <div class="text-center">
                        <button class="btn btn-primary btn-xl" id="submitButton" type="submit">Login</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

